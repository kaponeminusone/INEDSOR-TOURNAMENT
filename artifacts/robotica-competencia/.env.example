# Copia este archivo como .env.local y completa con los datos de tu proyecto:
# Supabase → Project Settings → API (URL del proyecto y la clave "publishable" (o la "anon" antigua)).
# La clave anon es pública por diseño; los permisos los protege schema.sql (RLS).
# Nunca pongas aquí la clave service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: cuenta compartida de organizador. El código de Control es su contraseña
# (cámbialo en Supabase → Authentication → Users). Por defecto: organizador@torneo-inedsor.app
# VITE_ORGANIZER_EMAIL=
